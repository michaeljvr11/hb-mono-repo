{
  "mcpServers": {
    "obsidian": {
      "type": "http",
      "url": "http://127.0.0.1:27123/mcp/",
      "headers": {
        "Authorization": "Bearer <OBSIDIAN_LOCAL_REST_API_KEY>"
      }
    },
    "trello": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-server-trello"],
      "env": {
        "TRELLO_API_KEY": "<KEY from trello.com/app-key>",
        "TRELLO_TOKEN": "<TOKEN from trello.com/app-key>",
        "TRELLO_BOARD_ID": "<short id from board URL, trello.com/b/THIS/...>"
      }
    }
  }
}
