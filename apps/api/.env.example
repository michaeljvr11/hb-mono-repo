# Copy to .env and adjust. Matches docker-compose defaults at the repo root.
PORT=3000
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=hbuser
DB_PASSWORD=devpassword123
DB_DATABASE=hb_ecommerce

# Generate long random values for anything beyond local dev.
JWT_SECRET=change-me-dev-only-access-secret
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-dev-only-refresh-secret
# Refresh-token longevity is driven by the login/register "remember me" choice
# (30d when ticked, 24h otherwise) — see auth.service.ts. No fixed value needed.

# Transactional email (password reset + verification). Sends are skipped with a
# warning when RESEND_API_KEY is empty, so local dev works without it.
RESEND_API_KEY=
MAIL_FROM=no-reply@hb-ecommerce.com
# Base URL the Angular app is served from. Used for emailed links AND as the
# redirect target after Google sign-in (-> {APP_WEB_URL}/auth/callback).
APP_WEB_URL=http://localhost:4200

# Google "Sign in with Google" (OAuth 2.0). Until these are set, the /auth/google
# route will not complete a real sign-in. The callback URL must be registered in
# the Google Cloud console and match GOOGLE_CALLBACK_URL exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
