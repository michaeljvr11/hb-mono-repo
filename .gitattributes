# Merge strategy for AI evidence files
#
# Both files are append-only or fully-regenerated — a union merge (all lines
# from both sides, no conflict markers) is semantically correct and works on
# GitHub's servers without any local driver installation.
#
# After any merge the post-merge hook (.claude/hooks/post-merge) runs
# "npm run evidence" to regenerate report.js / report.json / REPORT.md from
# the now-complete factory-log, so the union-merged content is immediately
# corrected and ready to commit.

.claude/factory-log.jsonl       merge=union
docs/ai-evidence/REPORT.md      merge=union
docs/ai-evidence/report.js      merge=union
docs/ai-evidence/report.json    merge=union
